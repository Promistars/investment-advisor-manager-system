[Unit]
Description=IAMS auto_fetch scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@IAMS_ROOT@
ExecStart=@IAMS_ROOT@/scripts/run_with_iams_env.sh @PYTHON@ @IAMS_ROOT@/auto_fetch.py
EnvironmentFile=-@IAMS_ROOT@/config/network.env
Restart=no
StandardOutput=append:@IAMS_ROOT@/fetch_log.txt
StandardError=append:@IAMS_ROOT@/fetch_log.txt

[Install]
WantedBy=default.target
