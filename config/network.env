# IAMS 项目专用网络（仅对本项目脚本 / systemd 服务生效，不改全局 ~/.bashrc）
# 默认直连，避免继承 shell 里失效的 127.0.0.1:7890 / socks 代理
IAMS_DISABLE_PROXY=1

# 说明：push2his.eastmoney.com（东财日 K）在本 GPU 服务器上常被防火墙拦截；
# 个股日线已自动优先走「新浪」；东财分红等其它接口仍可能可用。

# 若必须为本项目单独走代理，改为 IAMS_DISABLE_PROXY=0 并填写：
# IAMS_HTTP_PROXY=http://127.0.0.1:7890
# IAMS_HTTPS_PROXY=http://127.0.0.1:7890
